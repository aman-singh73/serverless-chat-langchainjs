# Environment Variables — copy to .env and fill in real values

NODE_ENV=development
PORT=3000

# Cosmos DB — test04-dev-cosmos
COSMOS_CONNECTION_STRING=AccountEndpoint=https://test04-dev-cosmos.documents.azure.com:443/;AccountKey=your-key

# Cosmos DB — test04-dev-cosmos-sql-db
COSMOS_CONNECTION_STRING=AccountEndpoint=https://test04-dev-cosmos-sql-db.documents.azure.com:443/;AccountKey=your-key

# Cosmos DB — test04-dev-cosmos-sql-container
COSMOS_CONNECTION_STRING=AccountEndpoint=https://test04-dev-cosmos-sql-container.documents.azure.com:443/;AccountKey=your-key

# Azure credentials (set by CI/CD — do not commit real values)
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group

# Integration templates (auto-added)
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
AZURE_STORAGE_CONNECTION_STRING=
